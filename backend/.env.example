# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string, must point at a database with the PostGIS extension
# enabled (`CREATE EXTENSION IF NOT EXISTS postgis;`). Works with Neon, Supabase,
# or a local Postgres+PostGIS instance.
# Example: postgresql+psycopg://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Long random string used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mapbox access token (only needed if the frontend is configured to use Mapbox
# instead of the default Leaflet/OpenStreetMap setup).
MAPBOX_TOKEN=

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

ENVIRONMENT=development
